---
import Icon from './Icon.astro';
import { questions } from '../data/reports';
import { reportHtml } from '../lib/report';
const first = questions[0].report;
const groups = [
  { key: 'op', title: 'Operativa', sub: 'výroba, sklad, logistika, obchod', icon: 'i-cogs' },
  { key: 'fi', title: 'Finance a vedení', sub: 'CFO, controlling, jednatelé', icon: 'i-chart-bar' },
] as const;
---
<div class="w-qgrid">
  <div class="w-qcols" role="group" aria-label="Vyberte otázku">
    {groups.map((g) => (
      <div class="w-qcol">
        <div class="w-qcol__head"><span class="w-cap__ic"><Icon name={g.icon} sprite="dom" /></span><div><h3 class="w-h3">{g.title}</h3><p class="w-small">{g.sub}</p></div></div>
        <ul class="w-qs">
          {questions.map((q, i) => q.group === g.key && (
            <li><button type="button" class="w-q" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="rep-q" data-q={i}><span>{q.q}</span><Icon name="i-arrow-right" /></button></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <figure class="w-dash w-on-navy w-qgrid__rep" aria-labelledby="rep-q-cap" style="margin:0">
    <div class="w-dash__top"><div><div class="w-dash__title" id="rep-q-cap">Odpověď z reportu</div><div class="w-dash__meta" id="rep-q-sub">{first.sub}</div></div><span class="w-badge">Ukázková data</span></div>
    <div class="w-rep" id="rep-q" aria-live="polite" set:html={reportHtml(first, first.sel)} />
  </figure>
</div>
<script>
  import { questions } from '../data/reports';
  import { bindReport } from '../lib/report';
  const el = document.getElementById('rep-q');
  const sub = document.getElementById('rep-q-sub');
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.w-q'));
  if (el) {
    let cur = 0;
    bindReport(el, () => questions[cur].report);
    btns.forEach((b) => b.addEventListener('click', () => {
      cur = Number(b.dataset.q);
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (sub) sub.textContent = questions[cur].report.sub ?? '';
      (el as HTMLElement & { resetReport?: () => void }).resetReport?.();
    }));
  }
</script>

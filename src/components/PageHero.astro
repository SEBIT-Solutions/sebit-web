---
interface Props { crumbs?: { href?: string; label: string }[]; title: string; lead?: string; id?: string }
const { crumbs = [], title, lead, id = 'h-page' } = Astro.props;
---
<section class="w-phero w-ground-page" aria-labelledby={id}>
  <div class="w-wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Drobečková navigace">
        <ol class="w-crumbs">
          <li><a href="/">Domů</a></li>
          {crumbs.map((c) => c.href ? <li><a href={c.href}>{c.label}</a></li> : <li aria-current="page">{c.label}</li>)}
        </ol>
      </nav>
    )}
    <h1 class="w-h1" id={id} set:html={title} />
    {lead && <p class="w-lead" set:html={lead} />}
    <slot />
  </div>
</section>

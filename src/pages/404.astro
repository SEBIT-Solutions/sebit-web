---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka nenalezena" description="Tato stránka na sebit.cz neexistuje." noindex>
  <section class="w-phero w-ground-page" aria-labelledby="h-404">
    <div class="w-wrap">
      <span class="w-badge w-badge--light" style="align-self:flex-start">404</span>
      <h1 class="w-h1" id="h-404">Tuhle stránku jsme nenašli.</h1>
      <p class="w-lead">Odkaz je možná starý — web jsme v roce 2026 přestavěli. Zkuste jednu z hlavních stránek.</p>
      <div class="w-hero__actions">
        <a class="kit-btn kit-btn--primary kit-btn--lg" href="/">Na úvodní stránku</a>
        <a class="kit-btn kit-btn--ghost kit-btn--lg" href="/co-delame/">Co děláme</a>
        <a class="kit-btn kit-btn--ghost kit-btn--lg" href="/kontakt/">Kontakt</a>
      </div>
    </div>
  </section>
</Base>

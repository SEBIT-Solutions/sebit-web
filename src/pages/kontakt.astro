---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { company, needs, sla } from '../data/site';
---
<Base title="Poptávka a kontakt" description="Popište nám, co potřebujete vědět, propojit nebo obsadit. info@sebit.cz · +420 721 405 384." noStickyCta>
  <PageHero crumbs={[{ label: 'Kontakt' }]} title="Řekněte nám, co potřebujete."
    lead="Čtyři krátké kroky, asi 2 minuty. Čím víc víme, tím přesnější návrh pošleme." />
  <section class="w-section w-ground-page" style="padding-top:var(--sb-size-12)" aria-label="Poptávkový formulář">
    <div class="w-wrap w-split w-split--wide-left">
      <div>
        <form class="w-form" id="brief" novalidate>
          <fieldset class="w-fieldset">
            <legend class="w-legend"><span class="w-mono">1/4</span>Co potřebujete?</legend>
            <div class="w-options">
              {needs.map((n, i) => (
                <div class="w-opt"><input type="radio" name="need" id={`n-${n.key}`} value={n.key} checked={i === 0} data-label={n.t} /><label for={`n-${n.key}`}><Icon name={n.icon} sprite="dom" /><div><b>{n.t}</b><span>{n.d}</span></div></label></div>
              ))}
            </div>
          </fieldset>
          <fieldset class="w-fieldset">
            <legend class="w-legend"><span class="w-mono">2/4</span>Upřesnění</legend>
            <div class="w-fields">
              <div class="w-field w-span2"><label for="f-role">Role nebo téma <span class="w-opt-tag">(volitelné)</span></label><input class="w-input" id="f-role" name="role" type="text" placeholder="Např. Power BI reporting pro vedení, Senior Business Analyst" /></div>
              <div class="w-field"><label for="f-when">Kdy začít</label><select class="w-input w-select" id="f-when" name="when"><option>Co nejdříve</option><option>Do měsíce</option><option>Za 1–3 měsíce</option><option>Zatím zjišťuji možnosti</option></select></div>
              <div class="w-field w-span2"><label for="f-urg">Naléhavost</label><select class="w-input w-select" id="f-urg" name="urg"><option value="standard">Standardní — odpověď {sla.standard}</option><option value="critical">Kritická — odpověď {sla.critical}</option></select></div>
              <div class="w-field"><label for="f-len">Předpokládaná délka</label><select class="w-input w-select" id="f-len" name="len"><option>Do 3 měsíců</option><option selected>3–12 měsíců</option><option>Déle než rok</option><option>Nevím</option></select></div>
            </div>
          </fieldset>
          <fieldset class="w-fieldset">
            <legend class="w-legend"><span class="w-mono">3/4</span>Na koho se obrátit</legend>
            <div class="w-fields">
              <div class="w-field"><label for="f-name">Jméno a příjmení</label><input class="w-input" id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" /><span class="w-err" id="e-name" hidden><Icon name="i-alert" />Pole je povinné. Vyplňte prosím své jméno.</span></div>
              <div class="w-field"><label for="f-mail">Pracovní e-mail</label><input class="w-input" id="f-mail" name="email" type="email" autocomplete="email" required aria-describedby="e-mail" /><span class="w-err" id="e-mail" hidden><Icon name="i-alert" />E-mail nemá správný tvar. Zkontrolujte prosím zavináč a doménu.</span></div>
              <div class="w-field"><label for="f-org">Firma nebo instituce <span class="w-opt-tag">(volitelné)</span></label><input class="w-input" id="f-org" name="org" type="text" autocomplete="organization" /></div>
              <div class="w-field"><label for="f-tel">Telefon <span class="w-opt-tag">(volitelné)</span></label><input class="w-input" id="f-tel" name="tel" type="tel" autocomplete="tel" /></div>
            </div>
          </fieldset>
          <fieldset class="w-fieldset">
            <legend class="w-legend"><span class="w-mono">4/4</span>Cokoliv dalšího</legend>
            <div class="w-field"><label for="f-msg">Zpráva <span class="w-opt-tag">(volitelné)</span></label><textarea class="w-textarea" id="f-msg" name="msg" placeholder="Systémy, data, velikost týmu, omezení, termíny…"></textarea><span class="w-help">Neposílejte prosím důvěrné informace. NDA rádi podepíšeme před detailní diskusí.</span></div>
          </fieldset>
          <p class="w-consent">Po odeslání se otevře váš e-mailový program s předvyplněnou zprávou pro {company.email} — odešlete ji odtud. Údaje zpracujeme jen pro odpověď na poptávku, viz <a href="/ochrana-osobnich-udaju/">zásady ochrany osobních údajů</a>.</p>
          <div><button class="kit-btn kit-btn--primary kit-btn--lg" type="submit">Odeslat zprávu <Icon name="i-arrow-right" /></button></div>
        </form>
        <div class="w-success" id="brief-ok" hidden tabindex="-1" role="status">
          <Icon name="i-check-circle" />
          <h2 class="w-h3">Zprávu máte připravenou v e-mailu.</h2>
          <p>Odešlete ji z e-mailového programu, který se právě otevřel. Pokud se neotevřel, napište nám přímo na <b>{company.email}</b>. Ozveme se {sla.standard}, s kritickým požadavkem {sla.critical}.</p>
          <div><button class="kit-btn kit-btn--ghost" type="button" id="brief-reset">Upravit poptávku</button></div>
        </div>
      </div>
      <aside class="w-aside w-sticky" aria-label="Přímý kontakt">
        <h2 class="w-h3">Raději přímo?</h2>
        <dl>
          <div><dt>E-mail</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a><button class="w-copy" type="button" data-copy={company.email}>Kopírovat</button></dd></div>
          <div><dt>Telefon</dt><dd><a href={`tel:${company.phoneHref}`}>{company.phone}</a><button class="w-copy" type="button" data-copy={company.phoneHref}>Kopírovat</button></dd></div>
          <div><dt>Sídlo</dt><dd class="w-aside__addr">{company.street}, {company.city}</dd></div>
          <div><dt>Jak rychle odpovídáme</dt><dd class="w-aside__addr">Standardně {sla.standard}<br />Kritické požadavky {sla.critical}</dd></div>
        </dl>
        <div class="w-stack w-aside__next">
          <h3 class="w-h4">Co se stane po odeslání</h3>
          <ol class="w-steps-mini">
            <li>Poptávku přečte člověk, ne robot.</li>
            <li>Ozveme se s doplňujícími otázkami nebo rovnou s návrhem.</li>
            <li>Domluvíme 30minutový úvodní hovor.</li>
          </ol>
        </div>
        <p class="w-small w-brand-text">Rádi vám pomůžeme!</p>
      </aside>
    </div>
  </section>
</Base>
<script>
  const form = document.getElementById('brief') as HTMLFormElement | null;
  const ok = document.getElementById('brief-ok');
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  // prefill from links such as /kontakt/?need=data&role=Power%20BI%20Developer
  const params = new URLSearchParams(location.search);
  const need = params.get('need');
  if (need) { const r = $<HTMLInputElement>(`n-${need}`); if (r) r.checked = true; }
  const role = params.get('role');
  if (role) { const f = $<HTMLInputElement>('f-role'); if (f) f.value = role; }

  function setErr(input: HTMLInputElement, errId: string, bad: boolean) {
    input.setAttribute('aria-invalid', bad ? 'true' : 'false');
    const e = $(errId); if (e) e.hidden = !bad;
  }
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = $<HTMLInputElement>('f-name')!, mail = $<HTMLInputElement>('f-mail')!;
    const badName = !name.value.trim();
    const badMail = !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail.value.trim());
    setErr(name, 'e-name', badName); setErr(mail, 'e-mail', badMail);
    if (badName) { name.focus(); return; }
    if (badMail) { mail.focus(); return; }
    const fd = new FormData(form);
    const needEl = form.querySelector<HTMLInputElement>('input[name="need"]:checked');
    const label = needEl?.dataset.label ?? '';
    const lines = [
      `Co potřebuji: ${label}`,
      fd.get('role') ? `Role nebo téma: ${fd.get('role')}` : '',
      `Kdy začít: ${fd.get('when')}`,
      `Předpokládaná délka: ${fd.get('len')}`,
      `Naléhavost: ${critical ? 'kritická' : 'standardní'}`,
      '',
      `Jméno: ${fd.get('name')}`,
      `E-mail: ${fd.get('email')}`,
      fd.get('org') ? `Firma: ${fd.get('org')}` : '',
      fd.get('tel') ? `Telefon: ${fd.get('tel')}` : '',
      '',
      String(fd.get('msg') ?? ''),
    ].filter((l, i, a) => l !== '' || (a[i - 1] ?? '') !== '');
    const critical = fd.get('urg') === 'critical';
    const subject = `${critical ? '[KRITICKÉ] ' : ''}Poptávka z webu: ${label}${fd.get('org') ? ` — ${fd.get('org')}` : ''}`;
    window.location.href = `mailto:info@sebit.cz?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    form.hidden = true;
    if (ok) { ok.hidden = false; ok.focus(); }
  });
  $('brief-reset')?.addEventListener('click', () => { if (form) form.hidden = false; if (ok) ok.hidden = true; $<HTMLInputElement>('f-name')?.focus(); });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Zkopírováno'; }
    catch { b.textContent = 'Označte a zkopírujte'; }
    setTimeout(() => { b.textContent = 'Kopírovat'; }, 1600);
  }));
</script>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Kariéra a SEBIT Academy" description="Pracujte na datových, integračních, AI a webových projektech. Placené stáže v SEBIT Academy pro studenty a juniory.">
  <PageHero crumbs={[{ label: 'Kariéra' }]} title="Data, AI, integrace a weby. Na skutečných projektech."
    lead="Hledáme seniory do datových, integračních, AI a webových projektů i do týmů u klientů. Studentům a juniorům nabízíme placené stáže v SEBIT Academy." />
  <section class="w-section w-ground-page" style="padding-top:var(--sb-size-12)" aria-labelledby="h-jobs">
    <div class="w-wrap w-split">
      <div class="w-stack"><h2 class="w-h2" id="h-jobs">Koho hledáme</h2><p class="w-body">Konkrétní pozice teď nevypisujeme. Lidi ale hledáme průběžně — ozvěte se, a až přijde projekt, který vám sedí, dáme vám vědět mezi prvními.</p></div>
      <div class="w-stack">
        <ul class="w-deliver" style="grid-template-columns:minmax(0,1fr)">
          <li><Icon name="i-check-circle" /><div><b>Data a reporting</b><span>Power BI, Microsoft Fabric, SQL, datové modely</span></div></li>
          <li><Icon name="i-check-circle" /><div><b>Integrace</b><span>API, SEBIT Gateway, ERP včetně Business Central</span></div></li>
          <li><Icon name="i-check-circle" /><div><b>Analýza a řízení projektů</b><span>business a IT analytici, projektoví manažeři</span></div></li>
          <li><Icon name="i-check-circle" /><div><b>Vývoj a bezpečnost</b><span>weby a aplikace, kybernetická bezpečnost</span></div></li>
        </ul>
        <div><a class="kit-btn kit-btn--primary" href="/kontakt/?need=academy">Poslat životopis</a></div>
      </div>
    </div>
  </section>
  <section class="w-section w-ground-navy w-on-navy" aria-labelledby="h-academy">
    <div class="w-wrap w-split w-split--even">
      <div class="w-stack">
        <img src="/assets/logos/sebit_academy_dark.svg" alt="SEBIT Academy" width="92" height="33" style="height:33px;width:auto;align-self:flex-start" />
        <h2 class="w-h2" id="h-academy">Placená stáž na reálném projektu. S mentorem.</h2>
        <p class="w-lead">Stáže v délce 3–6 měsíců pro studenty VŠ a VOŠ. Každý stážista má osobního mentora a pracuje na skutečném projektu, ne jen na podpoře.</p>
        <ul class="w-checks">
          <li><Icon name="i-check-circle" /><span>Reálné projekty, ne jen podpora</span></li>
          <li><Icon name="i-check-circle" /><span>Osobní mentor z praxe</span></li>
          <li><Icon name="i-check-circle" /><span>Možnost pokračovat i po studiu</span></li>
        </ul>
        <div><a class="kit-btn kit-btn--lime kit-btn--lg" href="/kontakt/?need=academy">Přihlásit se na stáž</a></div>
      </div>
      <div class="w-media w-media--navy"><img src="/favicon.svg" alt="" /><span>SEBIT Academy</span></div>
    </div>
  </section>
</Base>
